# ==============================================================================
# AI Health Agent — Environment Configuration Template
# Copy this file to .env and replace placeholders with your genuine credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Core Settings
# ------------------------------------------------------------------------------
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-very-secure-random-string
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (Oracle SQL / Autonomous DB / Local Fallback)
# ------------------------------------------------------------------------------
# DB_TYPE: 'oracle' for Oracle Database or 'sqlite' for zero-setup local dev/testing
DB_TYPE=sqlite
ORACLE_USER=ai_health_user
ORACLE_PASSWORD=YourStrongOraclePasswordHere123#
ORACLE_DSN=localhost:1521/XEPDB1
# For Oracle Cloud Autonomous Database wallet mode, uncomment and specify directory:
# ORACLE_CONFIG_DIR=/path/to/oracle/wallet
# ORACLE_WALLET_PASSWORD=YourWalletPasswordIfSet

# SQLite local storage path (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=database/ai_health.db

# ------------------------------------------------------------------------------
# 3. DigiLocker / API Setu Integration Credentials
# ------------------------------------------------------------------------------
# Register your application on DigiLocker / API Setu portal (https://partners.digitallocker.gov.in)
# Obtain your Client ID and Client Secret for the "Medical Council Registration" scope.
DIGILOCKER_ENV=sandbox
DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret_here
DIGILOCKER_REDIRECT_URI=http://127.0.0.1:5000/api/doctor/digilocker/callback

# DigiLocker endpoints (defaults to sandbox/staging; change for production)
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_DOC_URL=https://api.digitallocker.gov.in/public/oauth2/1/xml/issued
DIGILOCKER_PULL_URI=https://api.digitallocker.gov.in/public/oauth2/1/pull/uri

# ------------------------------------------------------------------------------
# 4. AI Provider Configuration (Google Gemini / Ollama / Fallback)
# ------------------------------------------------------------------------------
# AI_PROVIDER: 'gemini', 'ollama', or 'rule_based' (offline fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama settings (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=meditron

# ------------------------------------------------------------------------------
# 5. File Uploads & Security
# ------------------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB limit in bytes
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=False # Set to True in production with HTTPS
